# 本地访问配置；真实凭证只填入 .env。
# 将此模板复制为 .env 后填写；.env 已被 Git 忽略。
# 等号后直接填写值，不加引号或多余空格。
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KNOWLEDGE_BASE=任德耀新建华为PC知识库

# DeepSeek 模型访问；不填写真实密钥到模板或聊天中。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 官方更新检查记录保留在项目目录内。
IMA_LAST_CHECK_FILE=.ima-state/last_update_check
